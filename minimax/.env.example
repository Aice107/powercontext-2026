# MiniMax credentials (never commit a real key)
MINIMAX_API_KEY=<set-me>
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
MINIMAX_MODEL=MiniMax-M3
MINIMAX_API_STYLE=openai
MINIMAX_MAX_TOKENS=8192
# Optional for the native v2 endpoint:
# MINIMAX_GROUP_ID=<group-id>
MINIMAX_TIMEOUT=120

# PowerContext server used for task-state reuse
POWERCONTEXT_URL=http://127.0.0.1:8093
POWERCONTEXT_SCOPE_KEY=sdd-context-taskhub-demo
