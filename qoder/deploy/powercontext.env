# 在 submission/qoder 目录下启动：powercontext server run --env-file deploy/powercontext.env
# 相对路径以 submission/qoder 为基准，与应用共用同一份嵌入式 seekdb 数据目录。
POWERCONTEXT_HOME=./.data/pc-home
POWERCONTEXT_SERVER_HTTP_HOST=127.0.0.1
POWERCONTEXT_SERVER_HTTP_PORT=8000
POWERCONTEXT_SERVER_ACCESS_MODE=disabled
POWERCONTEXT_SERVER_DATABASE_KIND=seekdb
POWERCONTEXT_SERVER_DATABASE_PATH=./.data/seekdb
POWERCONTEXT_SERVER_INFERENCE_EMBEDDING_MODEL=openai:bge-small-zh-v1.5
POWERCONTEXT_SERVER_INFERENCE_EMBEDDING_BASE_URL=http://127.0.0.1:8710/v1
POWERCONTEXT_SERVER_INFERENCE_EMBEDDING_PROFILE_ID=local-bge-small-zh-v1.5-512
POWERCONTEXT_SERVER_INFERENCE_EMBEDDING_DIMENSION=512
POWERCONTEXT_SERVER_INFERENCE_EMBEDDING_SEND_DIMENSIONS=false
POWERCONTEXT_SERVER_INFERENCE_EMBEDDING_BATCH_SIZE=8
