1746031744,"matched_by":["text","vector"]},{"id":"art_2c20d55358924a5eac29060a89beb4e2","text":"组会材料要结论先行","kind":"preference","score":0.015625,"matched_by":["vector"]}]}],"evidence":{"hits":[{"chunk_id":"361eb9ccf4c7a0c2-002","doc_id":"361eb9ccf4c7a0c2","title":"组会纪要 1028","kind":"meeting","project":"vec-search","tags":"组会, 导师意见, 下周计划","doc_date":"2026-10-28","dd":20261028,"section":"我记下的约束","content":"- 汇报材料里，每个结论后面必须挂出处（哪篇笔记、哪条实验记录）。\n- 结论先行：先说这周做成了什么，再说细节。\n- 演示要能复现，评审/老师自己跑一遍就能出结果。","_score":0.0607,"snippet":"- 汇报材料里，每个结论后面必须挂出处（哪篇笔记、哪条实验记录）。\n- 结论先行：先说这周做成了什么，再说细节。\n- 演示要能复现，评审/老师自己跑一遍就能出结果。"},{"chunk_id":"361eb9ccf4c7a0c2-003","doc_id":"361eb9ccf4c7a0c2","title":"组会纪要 1028","kind":"meeting","project":"vec-search","tags":"组会, 导师意见, 下周计划","doc_date":"2026-10-28","dd":20261028,"section":"下周计划","content":"- 完成混合检索的一版实现，能展示单路 vs 融合的差异。\n- 出一个可交互的演示页面。\n- 把实验记录的日期范围作为筛选条件，能只取\"本周\"的证据。","_score":0.0593,"snippet":"- 完成混合检索的一版实现，能展示单路 vs 融合的差异。\n- 出一个可交互的演示页面。\n- 把实验记录的日期范围作为筛选条件，能只取\"本周\"的证据。"},{"chunk_id":"d870b1da1606fd1b-003","doc_id":"d870b1da1606fd1b","title":"学习笔记 seekdb 混合检索用法","kind":"note","project":"vec-search","tags":"seekdb, hybrid, sql","doc_date":"2026-10-26","dd":20261026,"section":"与向量库其它方案的差异","content":"我以前用的方案要单独跑一个全文引擎，索引和数据分两处，同步是长期的痛。\n合成一个存储之后，写入即索引，删除也不留悬挂结果。","_score":0.0573,"snippet":"我以前用的方案要单独跑一个全文引擎，索引和数据分两处，同步是长期的痛。\n合成一个存储之后，写入即索引，删除也不留悬挂结果。"},{"chunk_id":"a533936629a791b7-003","doc_id":"a533936629a791b7","title":"实验记录 1030 混合检索对照","kind":"experiment","project":"vec-search","tags":"hybrid, rrf, recall, 对照实验","doc_date":"2026-10-30","dd":20261030,"section":"结论","content":"混合检索有实质收益，不是把两路结果拼一下的错觉，因为两路的失败样本是互补的。","_score":0.0571,"snippet":"混合检索有实质收益，不是把两路结果拼一下的错觉，因为两路的失败样本是互补的。"},{"chunk_id":"d870b1da1606fd1b-001","doc_id":"d870b1da1606fd1b","title":"学习笔记 seekdb 混合检索用法","kind":"note","project":"vec-search","tags":"seekdb, hybrid, sql","doc_date":"2026-10-26","dd":20261026,"section":"一条语句完成混合检索","content":"数据库提供了混合检索的入口，用一段 JSON 描述查询：\n向量通道给字段名和查询向量，全文通道给字段名和查询词，\nfilter 通道给标量条件（等值、范围都可以），fusion 描述融合方式（RRF 或加权）与每路大小。\n\n这样做的意义在于融合发生在数据库内部：\n排序、截断、返回分数都在一次执行里完成，应用只拿到一个已经排好序的结果列表。\n排查问题的时候，可以直接看这条语句本身，而不是看两段代码各自的输出。","_score":0.0566,"snippet":"数据库提供了混合检索的入口，用一段 JSON 描述查询：\n向量通道给字段名和查询向量，全文通道给字段名和查询词，\nfilter 通道给标量条件（等值、范围都可以），fusion 描述融合方式（RRF 或加权）与每路大小。\n\n这样做的意义在于融合发生在数据库内部：\n排序、截断、返回分数都在一次执行里完成，应用只拿到一个已经排好序的结果列表。\n排查问题的时候，可以直接看这条语句本身，而不是看两段代码各自的输出。"},{"chunk_id":"d870b1da1606fd1b-002","doc_id":"d870b1da1606fd1b","title":"学习笔记 seekdb 混合检索用法","kind":"note","project":"vec-search","tags":"seekdb, hybrid, sql","doc_date":"2026-10-26","dd":20261026,"section":"结构化条件的作用","content":"日期范围、课题标签这些条件必须能下推。否则\"只取本周\"就要在应用层拉全量再过滤，\n语料一大就崩。把时间窗写成 filter 之后，本周的口径由数据库保证。","_score":0.0516,"snippet":"日期范围、课题标签这些条件必须能下推。否则\"只取本周\"就要在应用层拉全量再过滤，\n语料一大就崩。把时间窗写成 filter 之后，本周的口径由数据库保证。"},{"chunk_id":"d870b1da1606fd1b-000","doc_id":"d870b1da1606fd1b","title":"学习笔记 seekdb 混合检索用法","kind":"note","project":"vec-search","tags":"seekdb, hybrid, sql","doc_date":"2026-10-26","dd":20261026,"section":"一张表存三样东西","content":"同一个表里可以同时有向量列、全文索引和普通标量列。\n这意味着一次查询就能把语义近邻、关键词命中、结构化条件放在一起，\n不需要在应用层维护两个存储再手工拼结果。","_score":0.0507,"snippet":"同一个表里可以同时有向量列、全文索引和普通标量列。\n这意味着一次查询就能把语义近邻、关键词命中、结构化条件放在一起，\n不需要在应用层维护两个存储再手工拼结果。"},{"chunk_id":"d00da3c49e61a46b-001","doc_id":"d00da3c49e61a46b","title":"实验记录 1029 全文分词方案对照","kind":"experiment","project":"vec-search","tags":"ngram, tokenizer, fulltext","doc_date":"2026-10-29","dd":20261029,"section":"结论","content":"采用 bigram。unigram 虽然召回还行，但把\"检索\"和\"索\"这类碎片也算命中，\n排序质量很差，尾部噪声不可控。","_score":0.0313,"snippet":"采用 bigram。unigram 虽然召回还行，但把\"检索\"和\"索\"这类碎片也算命中，\n排序质量很差，尾部噪声不可控。"},{"chunk_id":"a533936629a791b7-000","doc_id":"a533936629a791b7","title":"实验记录 1030 混合检索对照","kind":"experiment","project":"vec-search","tags":"hybrid, rrf, recall, 对照实验","doc_date":"2026-10-30","dd":20261030,"section":"设置","content":"同一份 1873 chunk 语料、同一份 40 条查询集，比较三种检索方式。\n融合用 RRF，k=30，两路各取 Top20 参与融合。\n\n| 方式 | Recall@10 | 空召回率 | P95 |\n| --- | ---: | ---: | ---: |\n| 仅向量（ef_search=160） | 0.93 | 5.0% | 18.6ms |\n| 仅全文（ngram bigram） | 0.71 | 10.0% | 3.1ms |\n| 混合（RRF 融合） | 0.96 | 0.0% | 22.4ms |","_score":0.0303,"snippet":"同一份 1873 chunk 语料、同一份 40 条查询集，比较三种检索方式。\n融合用 RRF，k=30，两路各取 Top20 参与融合。\n\n| 方式 | Recall@10 | 空召回率 | P95 |\n| --- | ---: | ---: | ---: |\n| 仅向量（ef_search=160） | 0.93 | 5.0% | 18.6ms |\n| 仅全文（ngram bigram） | 0.71 | 10.0% | 3.1ms |\n| 混合（RRF 融合） | 0."},{"chunk_id":"361eb9ccf4c7a0c2-000","doc_id":"361eb9ccf4c7a0c2","title":"组会纪要 1028","kind":"meeting","project":"vec-search","tags":"组会, 导师意见, 下周计划","doc_date":"2026-10-28","dd":20261028,"section":"我汇报的内容","content":"汇报了 ef_search 扫描的结果，以及准备引入全文通道做混合检索的计划。","_score":0.0294,"snippet":"汇报了 ef_search 扫描的结果，以及准备引入全文通道做混合检索的计划。"},{"chunk_id":"a533936629a791b7-001","doc_id":"a533936629a791b7","title":"实验记录 1030 混合检索对照","kind":"experiment","project":"vec-search","tags":"hybrid, rrf, recall, 对照实验","doc_date":"2026-10-30","dd":20261030,"section":"关键差异","content":"- 之前 4 条含英文参数名的查询（`ef_search`、`nprobe`）在混合检索里全部进入前 5，\n  是全文通道直接命中的，向量通道给不出。\n- 有 2 条口语化的查询（\"量化会不会掉很多点\"）全文完全没命中，靠向量补回来了。\n- 混合检索的空召回率降到 0，这是这周最有说服力的一个数字。","_score":0.0278,"snippet":"- 之前 4 条含英文参数名的查询（`ef_search`、`nprobe`）在混合检索里全部进入前 5，\n  是全文通道直接命中的，向量通道给不出。\n- 有 2 条口语化的查询（\"量化会不会掉很多点\"）全文完全没命中，靠向量补回来了。\n- 混合检索的空召回率降到 0，这是这周最有说服力的一个数字。"},{"chunk_id":"a533936629a791b7-002","doc_id":"a533936629a791b7","title":"实验记录 1030 混合检索对照","kind":"experiment","project":"vec-search","tags":"hybrid, rrf, recall, 对照实验","doc_date":"2026-10-30","dd":20261030,"section":"代价","content":"延迟从 18.6ms 涨到 22.4ms，在 50ms 预算内可以接受。\n另外全文索引让索引体积涨了三成左右。","_score":0.027,"snippet":"延迟从 18.6ms 涨到 22.4ms，在 50ms 预算内可以接受。\n另外全文索引让索引体积涨了三成左右。"}],"dsl":{"query":{"bool":{"must":[{"match":{"content":"实验 结果 数据"}}],"filter":[{"range":{"dd":{"gte":20261026,"lte":20261101}}}]}},"knn":{"field":"embedding","k":12,"query_vector":"[-0.03432881832122803, -0.03331318870186806, -0.023299075663089752, 0.01696309819817543, -0.019045099616050