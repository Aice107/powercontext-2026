# inn-api 配置（复制为 .env 后修改；不要提交真实值）
SEEKDB_HOST=127.0.0.1
SEEKDB_PORT=2891
SEEKDB_USER=root
SEEKDB_PASSWORD=
SEEKDB_DATABASE=inn

# 向量模式：hash（离线，默认）/ api（OpenAI 兼容 embeddings）
EMBEDDING_MODE=hash
EMBEDDING_DIM=1024
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# EMBEDDING_API_KEY=<REPLACE_ME>
# EMBEDDING_MODEL=text-embedding-3-small

INN_API_HOST=0.0.0.0
INN_API_PORT=8010
